//radius and diameter of a circle
let radius = 5.0; 
print Area = pi() * pow(radius, 2) // area
print circumference = pi() * (radius * 2) //radius (delete one)

//workout hypotenuse
let A = 3; let B = 4;
print C = sqrt(pow(A, 2) + pow(B, 2))

// workout terminal velocity of a skydiver at a set weight
let Gravity = 9.80665;
print 
    ObjectName = "Skydiver",
    MassKg = 84.0,
    DragCoefficient = 1.0,
    AreaM2 = 0.7,
    AirDensity = real(null)
| extend AirDensity = iff(isnull(AirDensity), 1.225, AirDensity)
| extend ["TerminalVelocity (m/s)"] = sqrt((2.0 * MassKg * Gravity) / (AirDensity * DragCoefficient * AreaM2))
| project ObjectName, ['TerminalVelocity (m/s)']

//fibonacci sequence
range n from 0 to 100 step 1
| extend fibonacci = tolong(round((pow((1 + sqrt(5)) / 2, n) - pow((1 - sqrt(5)) / 2, n)) / sqrt(5)))

//manual IP search 
let one = toint(1);
let two = toint(2);
let three = toint(3);
let four = toint(4);
let five = toint(5);
let six = toint(6);
let seven = toint(7);
let eight = toint(8);
let nine = toint(9);
let zero = toint(0);
let dot = tostring(".");
DeviceNetworkEvents
| where LocalIP == strcat(one, nine, two, dot, one, six, eight, dot, one, dot, one)
| take one
